{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "780px",
			"wideSize": "1220px"
		},
		"color": {
			"custom": true,
			"defaultPalette": false,
			"palette": [
				{ "slug": "neon", "color": "#7cff9e", "name": "Vert néon" },
				{ "slug": "cyan", "color": "#34e5ff", "name": "Cyan" },
				{ "slug": "violet", "color": "#b07cff", "name": "Violet" },
				{ "slug": "lime", "color": "#c8ff4d", "name": "Citron électrique" },
				{ "slug": "void", "color": "#04070c", "name": "Nuit" },
				{ "slug": "deep", "color": "#071019", "name": "Nuit profonde" },
				{ "slug": "text", "color": "#e6f1ec", "name": "Texte" },
				{ "slug": "muted", "color": "#8ea3a0", "name": "Texte discret" }
			],
			"gradients": [
				{
					"slug": "neon",
					"gradient": "linear-gradient(120deg, #7cff9e 0%, #34e5ff 100%)",
					"name": "Néon"
				},
				{
					"slug": "aurora",
					"gradient": "linear-gradient(140deg, #7cff9e 0%, #34e5ff 55%, #b07cff 100%)",
					"name": "Aurore"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Sans (système)",
					"fontFamily": "\"Segoe UI\", Roboto, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono (données)",
					"fontFamily": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.88rem", "name": "Petit" },
				{ "slug": "medium", "size": "1.06rem", "name": "Moyen" },
				{ "slug": "large", "size": "1.55rem", "name": "Grand" },
				{ "slug": "x-large", "size": "2.6rem", "name": "Très grand" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--void)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--neon)" }
			},
			"h1": {
				"typography": { "fontWeight": "700", "lineHeight": "1.08", "letterSpacing": "-0.025em" }
			},
			"h2": {
				"typography": { "fontWeight": "700", "lineHeight": "1.12", "letterSpacing": "-0.025em" }
			},
			"h3": {
				"typography": { "fontWeight": "700", "letterSpacing": "-0.02em" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--neon)",
					"text": "var(--wp--preset--color--void)"
				},
				"border": { "radius": "999px" },
				"spacing": {
					"padding": { "top": "12px", "bottom": "12px", "left": "28px", "right": "28px" }
				}
			}
		}
	}
}
