{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1180px"
		},
		"color": {
			"custom": true,
			"defaultPalette": false,
			"palette": [
				{ "slug": "green", "color": "#1f7a4d", "name": "Vert Health'eat" },
				{ "slug": "green-dark", "color": "#14532d", "name": "Vert profond" },
				{ "slug": "lime", "color": "#a3d977", "name": "Citron vert" },
				{ "slug": "cream", "color": "#f7f5ef", "name": "Crème" },
				{ "slug": "ink", "color": "#23291f", "name": "Encre" },
				{ "slug": "muted", "color": "#6b7264", "name": "Gris sauge" },
				{ "slug": "white", "color": "#ffffff", "name": "Blanc" }
			],
			"gradients": [
				{
					"slug": "fresh",
					"gradient": "linear-gradient(160deg, #eef5e9 0%, #f7f5ef 60%)",
					"name": "Fraîcheur"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Sans (système)",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "serif",
					"name": "Serif éditoriale",
					"fontFamily": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, \"Times New Roman\", serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.88rem", "name": "Petit" },
				{ "slug": "medium", "size": "1.06rem", "name": "Moyen" },
				{ "slug": "large", "size": "1.5rem", "name": "Grand" },
				{ "slug": "x-large", "size": "2.4rem", "name": "Très grand" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--cream)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--green)" }
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "600",
					"lineHeight": "1.15"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "600",
					"lineHeight": "1.2"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "600"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--green)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": { "radius": "999px" },
				"spacing": {
					"padding": { "top": "12px", "bottom": "12px", "left": "26px", "right": "26px" }
				}
			}
		}
	}
}
